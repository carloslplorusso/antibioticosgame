        let gameState = {
            score: 0,
            streak: 1,
            completedCases: [],
            currentCaseId: null,
            currentNodeKey: null,
            currentShuffledOptions: [],
            lastOptimalIndex: 0,
            visitedPath: [],
            rescuesInCurrentCase: 0
        };

        // Mezcla las opciones y evita que la respuesta óptima caiga siempre en la A o repita posición
        function shuffleOptionsAvoidingA(options) {
            const copy = options.slice();
            for (let attempt = 0; attempt < 12; attempt++) {
                for (let i = copy.length - 1; i > 0; i--) {
                    const j = Math.floor(Math.random() * (i + 1));
                    const temp = copy[i];
                    copy[i] = copy[j];
                    copy[j] = temp;
                }
                const optimalIdx = copy.findIndex(function(o) { return o.quality === 'optimal'; });
                if (optimalIdx !== 0 && optimalIdx !== gameState.lastOptimalIndex) {
                    gameState.lastOptimalIndex = optimalIdx;
                    return copy;
                }
            }
            return copy;
        }

        function updateHUD() {
            document.getElementById('hudScore').textContent = `${gameState.score} pts`;
            document.getElementById('hudStreak').textContent = `x${gameState.streak}`;
