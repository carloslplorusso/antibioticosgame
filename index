<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fármaco Fácil: Simulador Clínico de Antibioticoterapia Odontológica</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Montserrat & Plus Jakarta Sans & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500;700&family=Montserrat:wght@700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Phosphor Icons -->
    <script src="https://unpkg.com/@phosphor-icons/web"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            purple: '#5642CC',
                            deep: '#382699',
                            darker: '#1E1359',
                            night: '#130B3B',
                            mint: '#1EE0B6',
                            mintDark: '#12B893',
                            coral: '#FF4D6D',
                            amber: '#FFB800',
                            lavender: '#DCD6FF'
                        }
                    },
                    fontFamily: {
                        display: ['Montserrat', 'sans-serif'],
                        sans: ['Plus Jakarta Sans', 'sans-serif'],
                        mono: ['JetBrains Mono', 'monospace']
                    }
                }
            }
        }
    </script>

    <style>
        :root {
            --bg-primary: #5642CC;
            --bg-deep: #2B1C78;
            --accent-mint: #1EE0B6;
            --accent-coral: #FF4D6D;
        }

        body {
            background: linear-gradient(145deg, #5642CC 0%, #3E2BA8 55%, #231566 100%);
            color: #FFFFFF;
            font-family: 'Plus Jakarta Sans', sans-serif;
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* Brush Stroke Effect from Reference Image */
        .brush-banner {
            background: #1EE0B6;
            clip-path: polygon(1% 10%, 98% 3%, 100% 35%, 97% 70%, 99% 94%, 2% 97%, 0% 65%, 2% 30%);
        }

        /* Clean Minimalist Glass Cards */
        .clean-card {
            background: rgba(25, 15, 74, 0.65);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.14);
        }

        /* Minimalist Tactile Option Buttons */
        .option-card {
            transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
            background: rgba(255, 255, 255, 0.06);
            border: 1.5px solid rgba(255, 255, 255, 0.14);
        }

        .option-card:hover {
            transform: translateY(-2px);
            background: rgba(30, 224, 182, 0.12);
            border-color: #1EE0B6;
        }

        .option-card:active {
            transform: scale(0.99);
        }

        /* Subtle Pulse for Active Infection */
        @keyframes softPulse {
            0%, 100% { transform: scale(1); opacity: 0.75; }
            50% { transform: scale(1.1); opacity: 0.95; }
        }

        .hotspot-pulse {
            animation: softPulse 2s ease-in-out infinite;
            transform-origin: center;
        }

        /* Score Pop Animation */
        @keyframes popScore {
            0% { opacity: 0; transform: translateY(10px) scale(0.9); }
            25% { opacity: 1; transform: translateY(0) scale(1.05); }
            80% { opacity: 1; transform: translateY(-10px) scale(1); }
            100% { opacity: 0; transform: translateY(-24px) scale(0.95); }
        }

        .score-float {
            animation: popScore 1.4s ease-out forwards;
        }
    </style>
</head>
<body class="selection:bg-brand-mint selection:text-brand-night flex flex-col min-h-screen">

    <!-- Floating Score Notification -->
    <div id="floatingScoreContainer" class="fixed top-20 right-6 z-50 pointer-events-none flex flex-col gap-2"></div>

    <!-- MINIMALIST TOP BAR -->
    <header class="sticky top-0 z-40 bg-brand-night/70 backdrop-blur-md border-b border-white/10">
        <div class="max-w-5xl mx-auto px-4 py-3 flex items-center justify-between gap-3">
            <!-- Brand -->
            <button onclick="showWelcomeScreen()" class="flex items-center gap-2.5 text-left group">
                <div class="w-9 h-9 rounded-xl bg-brand-mint flex items-center justify-center text-brand-night font-black text-xl group-hover:scale-105 transition">
                    <i class="ph-fill ph-tooth"></i>
                </div>
                <div>
                    <span class="block text-[10px] font-extrabold tracking-widest uppercase text-brand-mint leading-none">
                        DR. CARLOS PETIT LORUSSO
                    </span>
                    <span class="font-display font-black text-base sm:text-lg text-white tracking-tight">
                        FÁRMACO FÁCIL
                    </span>
                </div>
            </button>

            <!-- Minimalist Score & Quick Tools -->
            <div class="flex items-center gap-2">
                <!-- Score Pill -->
                <div class="bg-white/10 border border-white/15 rounded-xl px-3 py-1.5 flex items-center gap-2">
                    <i class="ph-fill ph-trophy text-brand-mint text-base"></i>
                    <span id="hudScore" class="font-mono font-bold text-sm text-white">0 pts</span>
                    <span id="hudStreak" class="text-[11px] font-mono font-bold px-1.5 py-0.5 rounded bg-brand-mint/20 text-brand-mint">x1</span>
                </div>

                <!-- Reference Guide Button -->
                <button onclick="toggleModal('vademecumModal')" class="px-3 py-1.5 rounded-xl bg-white/10 hover:bg-brand-mint hover:text-brand-night transition font-bold text-xs flex items-center gap-1.5 border border-white/15" title="Resumen de Dosis">
                    <i class="ph-bold ph-book-open text-sm"></i>
                    <span class="hidden sm:inline">Guía Rápida</span>
                </button>

                <!-- Calculator Button -->
                <button onclick="toggleModal('calcModal')" class="px-3 py-1.5 rounded-xl bg-white/10 hover:bg-brand-mint hover:text-brand-night transition font-bold text-xs flex items-center gap-1.5 border border-white/15" title="Calculadora Pediátrica e IV">
                    <i class="ph-bold ph-calculator text-sm text-brand-mint"></i>
                    <span class="hidden sm:inline">Calculadora</span>
                </button>

                <!-- Sound Toggle -->
                <button onclick="toggleSound()" class="w-8 h-8 rounded-xl bg-white/10 hover:bg-white/20 flex items-center justify-center text-brand-mint border border-white/15 transition" title="Sonido">
                    <i id="soundIcon" class="ph-fill ph-speaker-high text-base"></i>
                </button>
            </div>
        </div>
    </header>

    <!-- MAIN WORKSPACE (CENTERED & MINIMALIST) -->
    <main class="max-w-5xl w-full mx-auto px-4 py-6 flex-1 flex flex-col justify-center">

        <!-- ========================================== -->
        <!-- SCREEN 1: MINIMALIST HOME & CASE SELECTOR  -->
        <!-- ========================================== -->
        <section id="welcomeScreen" class="space-y-6">
            <!-- Clean Poster Hero Inspired by Reference Image -->
            <div class="rounded-3xl bg-gradient-to-br from-[#5B46D6] to-[#3B27A1] border border-white/20 p-6 sm:p-8 shadow-xl flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
                <div class="space-y-2 max-w-xl">
                    <span class="text-xs font-extrabold tracking-widest uppercase text-brand-mint">
                        CURSO ONLINE • ODONTOLOGÍA BASADA EN EVIDENCIA
                    </span>
                    <h1 class="font-display font-black text-3xl sm:text-5xl text-white tracking-tight leading-none">
                        FÁRMACO FÁCIL: <span class="text-brand-mint">Antibióticos</span>
                    </h1>
                    <p class="text-sm sm:text-base text-brand-lavender/90 pt-1">
                        Elige un paciente y toma decisiones paso a paso. El cuadro clínico <strong>mejorará o se complicará</strong> según tu receta.
                    </p>
                </div>

                <!-- Signature Mint Brush Badge -->
                <div class="brush-banner px-6 py-4 text-brand-night shrink-0 self-stretch md:self-auto flex flex-col justify-center">
                    <div class="text-xs font-extrabold uppercase tracking-wider opacity-80">Simulador Interactivo</div>
                    <div class="font-display font-black text-base sm:text-lg leading-tight mt-0.5">
                        • 5 Casos Clínicos<br>
                        • Algoritmo en Vivo<br>
                        • Gana o Pierde Puntos
                    </div>
                </div>
            </div>

            <!-- Simple 5-Case Grid -->
            <div class="space-y-3">
                <div class="flex items-center justify-between">
                    <h2 class="text-sm font-extrabold uppercase tracking-wider text-brand-mint flex items-center gap-2">
                        <i class="ph-fill ph-play-circle text-lg"></i> Selecciona un Caso para Jugar
                    </h2>
                    <button onclick="resetAllProgress()" class="text-xs text-brand-lavender hover:text-white flex items-center gap-1 transition">
                        <i class="ph-bold ph-arrow-counter-clockwise"></i> Reiniciar puntos
                    </button>
                </div>

                <div id="casesGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3.5">
                    <!-- Populated by JS -->
                </div>
            </div>
        </section>

        <!-- ========================================== -->
        <!-- SCREEN 2: MINIMALIST GAMEPLAY VIEW         -->
        <!-- ========================================== -->
        <section id="simulatorScreen" class="hidden space-y-4">

            <!-- Top Quick Navigation & Step Dots -->
            <div class="flex flex-wrap items-center justify-between gap-2">
                <button onclick="showWelcomeScreen()" class="px-3 py-1.5 rounded-xl bg-white/10 hover:bg-white/20 text-xs font-bold flex items-center gap-1.5 transition">
                    <i class="ph-bold ph-squares-four"></i> Cambiar de Caso
                </button>

                <!-- Minimalist Step Progress Pills -->
                <div id="algorithmBreadcrumb" class="flex items-center gap-1.5 overflow-x-auto py-1">
                    <!-- Populated dynamically -->
                </div>
            </div>

            <!-- Feedback Toast (Only visible after making a decision) -->
            <div id="lastDecisionFeedback" class="hidden rounded-2xl px-4 py-3 border transition-all">
                <div class="flex items-center justify-between gap-3">
                    <div class="flex items-center gap-3">
                        <div id="feedbackIconBox" class="w-8 h-8 rounded-lg flex items-center justify-center shrink-0"></div>
                        <div>
                            <div class="flex items-center gap-2">
                                <span id="feedbackTitle" class="font-extrabold text-xs uppercase tracking-wider"></span>
                                <span id="feedbackPointsBadge" class="font-mono font-bold text-xs px-2 py-0.5 rounded"></span>
                            </div>
                            <p id="feedbackRationale" class="text-xs sm:text-sm text-white/95 mt-0.5"></p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- UNIFIED GAME CARD: Left Visual Patient + Right Decision Choices -->
            <div id="scenarioNarrativeCard" class="clean-card rounded-3xl p-5 sm:p-7 shadow-2xl transition-all">
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-center">

                    <!-- LEFT (5 Cols): Clean Visual Patient Card -->
                    <div class="lg:col-span-5 flex flex-col items-center bg-brand-night/60 rounded-2xl p-5 border border-white/10 space-y-4">
                        <!-- Patient Header & Allergy Pill -->
                        <div class="w-full flex items-center justify-between gap-2">
                            <div>
                                <div id="patientNameAge" class="text-[11px] font-bold uppercase tracking-wider text-brand-lavender">Masculino, 34 años</div>
                                <div id="patientDiagnosisTag" class="font-display font-extrabold text-base text-white">Pieza 46</div>
                            </div>
                            <span id="allergyBadge" class="px-2.5 py-1 rounded-lg text-[11px] font-extrabold">
                                Sin Alergias
                            </span>
                        </div>

                        <!-- Main Interactive Graphic -->
                        <div class="relative w-full flex flex-col items-center justify-center py-2">
                            <div id="svgPatientContainer" class="w-full flex items-center justify-center">
                                <!-- SVG Injected by JS -->
                            </div>
                            <div id="visualCaption" class="text-xs text-center text-brand-lavender font-medium mt-2">
                                <!-- Short visual state caption -->
                            </div>
                        </div>

                        <!-- Stability Bar -->
                        <div class="w-full space-y-1">
                            <div class="flex justify-between text-[11px] font-bold">
                                <span class="text-brand-lavender">Evolución del Paciente</span>
                                <span id="stabilityText" class="font-mono text-brand-mint">75%</span>
                            </div>
                            <div class="w-full h-2.5 bg-white/10 rounded-full overflow-hidden">
                                <div id="stabilityBar" class="h-full rounded-full bg-brand-mint transition-all duration-500" style="width: 75%"></div>
                            </div>
                        </div>

                        <!-- 3 Essential Vital Signs Pills -->
                        <div class="w-full grid grid-cols-3 gap-2 pt-1 text-center">
                            <div class="bg-white/5 rounded-xl py-2 px-1 border border-white/10">
                                <div class="text-[10px] text-brand-lavender">Fiebre</div>
                                <div id="vitalTemp" class="font-mono font-bold text-xs sm:text-sm text-white">37.8 °C</div>
                            </div>
                            <div class="bg-white/5 rounded-xl py-2 px-1 border border-white/10">
                                <div class="text-[10px] text-brand-lavender">Apertura</div>
                                <div id="vitalTrismus" class="font-mono font-bold text-xs sm:text-sm text-brand-mint">38 mm</div>
                            </div>
                            <div class="bg-white/5 rounded-xl py-2 px-1 border border-white/10">
                                <div class="text-[10px] text-brand-lavender">Vía Aérea</div>
                                <div id="vitalAirway" class="font-mono font-bold text-xs sm:text-sm text-brand-mint">Normal</div>
                            </div>
                        </div>
                    </div>

                    <!-- RIGHT (7 Cols): Concise Scenario & Clear Choices -->
                    <div class="lg:col-span-7 space-y-5">

                        <!-- Urgent Complication Alert (Hidden unless patient worsens) -->
                        <div id="complicationAlertBanner" class="hidden rounded-xl bg-brand-coral/20 border border-brand-coral px-3.5 py-2.5 flex items-center gap-2.5">
                            <i class="ph-fill ph-warning-octagon text-brand-coral text-xl shrink-0"></i>
                            <span class="text-xs font-extrabold uppercase tracking-wide text-brand-coral">
                                ¡El paciente empeoró! Cambia de ruta terapéutica
                            </span>
                        </div>

                        <!-- Scenario Title & Short Description -->
                        <div class="space-y-2">
                            <div class="flex items-center justify-between">
                                <span id="nodeStageLabel" class="text-xs font-extrabold uppercase tracking-wider text-brand-mint">
                                    PASO 1
                                </span>
                                <!-- Optional Collapsible Hint Button -->
                                <button onclick="toggleHint()" class="text-xs font-bold text-brand-lavender hover:text-brand-mint flex items-center gap-1 transition">
                                    <i class="ph-fill ph-lightbulb"></i> Ver pista clínica
                                </button>
                            </div>

                            <!-- Hidden Hint Box -->
                            <div id="hintBox" class="hidden rounded-xl bg-brand-purple/50 border border-brand-mint/30 p-3 text-xs text-brand-lavender">
                                <strong class="text-brand-mint">Pista:</strong> <span id="clinicalPearlText"></span>
                            </div>

                            <h3 id="nodeHeadline" class="font-display font-black text-xl sm:text-2xl text-white leading-tight">
                                Título de la situación
                            </h3>

                            <div id="nodeDescription" class="text-sm sm:text-base text-brand-lavender/95 leading-relaxed space-y-1.5">
                                <!-- Concise scenario text -->
                            </div>
                        </div>

                        <!-- Tactile Options List -->
                        <div class="space-y-2.5 pt-1">
                            <div class="flex items-center justify-between">
                                <span class="text-[11px] font-extrabold uppercase tracking-wider text-white/60">
                                    Selecciona tu conducta (varias pueden ser válidas):
                                </span>
                                <span class="text-[11px] font-bold text-brand-mint">4 opciones disponibles</span>
                            </div>
                            <div id="optionsContainer" class="space-y-2.5">
                                <!-- Option buttons injected here -->
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </section>

    </main>

    <!-- ===================================================== -->
    <!-- MODAL 1: MINIMALIST QUICK GUIDE (VADEMÉCUM)           -->
    <!-- ===================================================== -->
    <div id="vademecumModal" class="fixed inset-0 z-50 hidden bg-brand-night/80 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="clean-card rounded-3xl max-w-2xl w-full max-h-[85vh] flex flex-col overflow-hidden border border-white/20">
            <div class="p-4 bg-brand-darker border-b border-white/10 flex items-center justify-between">
                <div class="flex items-center gap-2.5">
                    <i class="ph-fill ph-book-open text-brand-mint text-xl"></i>
                    <h3 class="font-display font-extrabold text-base text-white">Guía Rápida de Antibióticos (Dr. Petit Lorusso)</h3>
                </div>
                <button onclick="toggleModal('vademecumModal')" class="w-8 h-8 rounded-lg bg-white/10 hover:bg-brand-coral text-white flex items-center justify-center">
                    <i class="ph-bold ph-x"></i>
                </button>
            </div>

            <div class="p-5 overflow-y-auto space-y-4 text-xs sm:text-sm">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div class="bg-white/5 p-3.5 rounded-2xl border border-white/10">
                        <div class="font-extrabold text-brand-mint">Amoxicilina ± Ác. Clavulánico</div>
                        <div class="text-xs text-brand-lavender mt-1">
                            • <strong>Efecto:</strong> Bactericida (pared celular PBP).<br>
                            • <strong>Dosis Adulto:</strong> 500-875 mg c/8h o Amox/Clav 875/125 mg c/8h (7 días).<br>
                            • <strong>Clave:</strong> 1.ª elección en pacientes sin alergia.
                        </div>
                    </div>
                    <div class="bg-white/5 p-3.5 rounded-2xl border border-white/10">
                        <div class="font-extrabold text-brand-mint">Clindamicina (Lincosamida)</div>
                        <div class="text-xs text-brand-lavender mt-1">
                            • <strong>Efecto:</strong> Subunidad 50S. Penetra <strong>40% en hueso</strong> y <strong>30% en pus</strong>.<br>
                            • <strong>Dosis:</strong> VO 300-450 mg c/6h (con 1 vaso lleno de agua). IV 600 mg c/6h.<br>
                            • <strong>Alerta:</strong> Suspender si hay diarrea (prohibido dar Loperamida).
                        </div>
                    </div>
                    <div class="bg-white/5 p-3.5 rounded-2xl border border-white/10">
                        <div class="font-extrabold text-brand-mint">Doxiciclina (Tetraciclina)</div>
                        <div class="text-xs text-brand-lavender mt-1">
                            • <strong>Efecto:</strong> Subunidad 30S + inhibe colagenasas.<br>
                            • <strong>Dosis:</strong> Día 1: 100 mg c/12h; luego 100 mg c/24h.<br>
                            • <strong>Clave:</strong> No tomar con lácteos/antiácidos. Prohibida en &lt; 8 años.
                        </div>
                    </div>
                    <div class="bg-white/5 p-3.5 rounded-2xl border border-white/10">
                        <div class="font-extrabold text-brand-mint">Reglas Anatómicas e IV</div>
                        <div class="text-xs text-brand-lavender mt-1">
                            • <strong>Línea Milohioidea:</strong> 1.er molar (encima) → Sublingual. 2.º/3.er molar (debajo) → Submandibular.<br>
                            • <strong>Clindamicina IV:</strong> Prohibido bolo directo. Diluir ≤ 12 mg/ml y pasar ≤ 30 mg/min.
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ===================================================== -->
    <!-- MODAL 2: SIMPLE PEDIATRIC & IV CALCULATOR             -->
    <!-- ===================================================== -->
    <div id="calcModal" class="fixed inset-0 z-50 hidden bg-brand-night/80 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="clean-card rounded-3xl max-w-md w-full overflow-hidden border border-white/20">
            <div class="p-4 bg-brand-darker border-b border-white/10 flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <i class="ph-fill ph-calculator text-brand-mint text-xl"></i>
                    <h3 class="font-display font-extrabold text-base text-white">Calculadora Rápida de Dosis</h3>
                </div>
                <button onclick="toggleModal('calcModal')" class="w-8 h-8 rounded-lg bg-white/10 hover:bg-brand-coral text-white flex items-center justify-center">
                    <i class="ph-bold ph-x"></i>
                </button>
            </div>

            <div class="p-5 space-y-4">
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="text-xs text-brand-lavender block mb-1">Peso del Paciente (kg)</label>
                        <input type="number" id="calcWeight" value="18" oninput="updateCalculator()" class="w-full bg-brand-night border border-white/20 rounded-xl px-3 py-2 font-mono font-bold text-white">
                    </div>
                    <div>
                        <label class="text-xs text-brand-lavender block mb-1">Esquema (mg/kg/día)</label>
                        <select id="calcMgKg" onchange="updateCalculator()" class="w-full bg-brand-night border border-white/20 rounded-xl px-3 py-2 font-mono font-bold text-white">
                            <option value="20" selected>20 mg/kg/día (Clinda IV)</option>
                            <option value="40">40 mg/kg/día (Amox Susp)</option>
                            <option value="15">15 mg/kg/día (Clinda VO)</option>
                        </select>
                    </div>
                </div>

                <div class="bg-brand-night/80 rounded-2xl p-4 border border-brand-mint/30 grid grid-cols-3 gap-2 text-center">
                    <div>
                        <div class="text-[10px] text-brand-lavender uppercase">Total Día</div>
                        <div id="resTotalDay" class="font-mono font-extrabold text-base text-white">360 mg</div>
                    </div>
                    <div>
                        <div class="text-[10px] text-brand-lavender uppercase">Cada 8 Horas</div>
                        <div id="resPerDose" class="font-mono font-extrabold text-base text-brand-mint">120 mg</div>
                    </div>
                    <div>
                        <div class="text-[10px] text-brand-lavender uppercase">Vial (150mg/ml)</div>
                        <div id="resVialMl" class="font-mono font-extrabold text-base text-brand-amber">0.8 ml</div>
                    </div>
                </div>

                <div class="text-xs text-brand-lavender bg-white/5 p-3 rounded-xl border border-white/10">
                    <strong class="text-brand-mint">Seguridad IV Clindamicina:</strong> Diluir siempre a <strong>≤ 12 mg/ml</strong> e infundir en 10-60 min (<strong>≤ 30 mg/min</strong>). Nunca administrar en bolo directo.
                </div>
            </div>
        </div>
    </div>

    <!-- ===================================================== -->
    <!-- MODAL 3: CLEAN CASE COMPLETION                        -->
    <!-- ===================================================== -->
    <div id="caseCompleteModal" class="fixed inset-0 z-50 hidden bg-brand-night/85 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="clean-card rounded-3xl max-w-md w-full p-6 text-center space-y-5 border-2 border-brand-mint">
            <div class="w-16 h-16 rounded-2xl bg-brand-mint/20 border border-brand-mint text-brand-mint flex items-center justify-center mx-auto text-4xl">
                <i class="ph-fill ph-check-Fat ph-check-circle"></i>
            </div>

            <div class="space-y-1">
                <span class="text-[11px] font-extrabold uppercase tracking-widest text-brand-mint">PACIENTE DADO DE ALTA</span>
                <h3 id="completeModalTitle" class="font-display font-black text-2xl text-white">¡Caso Completado!</h3>
                <p id="completeModalSummary" class="text-xs sm:text-sm text-brand-lavender pt-1"></p>
            </div>

            <div class="bg-brand-night/60 p-3.5 rounded-2xl border border-white/10 flex justify-around">
