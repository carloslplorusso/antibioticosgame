            const weight = parseFloat(document.getElementById('calcWeight').value) || 0;
            const mgKg = parseFloat(document.getElementById('calcMgKg').value) || 0;
            const totalDay = weight * mgKg;
            const perDose = totalDay / 3;
            const vialMl = perDose / 150;

            document.getElementById('resTotalDay').textContent = `${Math.round(totalDay)} mg`;
            document.getElementById('resPerDose').textContent = `${Math.round(perDose)} mg`;
            document.getElementById('resVialMl').textContent = `${vialMl.toFixed(1)} ml`;
        }

        window.onload = function() {
            updateHUD();
            renderCasesGrid();
            updateCalculator();
        };
    </script>
</body>
</html>
