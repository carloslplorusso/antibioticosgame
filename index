        function triggerFloatingScore(points) {
            const container = document.getElementById('floatingScoreContainer');
            const badge = document.createElement('div');
            const isPos = points >= 0;
            badge.className = `score-float px-3.5 py-1.5 rounded-xl font-mono font-black text-sm shadow-lg ${
                isPos ? 'bg-brand-mint text-brand-night' : 'bg-brand-coral text-white'
            }`;
            badge.textContent = isPos ? `+${points} pts` : `${points} pts`;
            container.appendChild(badge);
            setTimeout(() => badge.remove(), 1400);
        }

