        function startCase(caseId) {
            const clinicalCase = CLINICAL_CASES.find(c => c.id === caseId);
            if (!clinicalCase) return;

            gameState.currentCaseId = caseId;
            gameState.currentNodeKey = "start";
            gameState.visitedPath = [{ label: "Inicio", status: "initial" }];
            gameState.rescuesInCurrentCase = 0;

            document.getElementById('patientNameAge').textContent = clinicalCase.patient;
            document.getElementById('patientDiagnosisTag').textContent = clinicalCase.tooth;
            document.getElementById('clinicalPearlText').textContent = clinicalCase.pearl;
            document.getElementById('hintBox').classList.add('hidden');
            document.getElementById('lastDecisionFeedback').classList.add('hidden');

            const allergyBadge = document.getElementById('allergyBadge');
            allergyBadge.textContent = clinicalCase.allergy;
            allergyBadge.className = clinicalCase.allergyType === 'danger'
                ? "px-2.5 py-1 rounded-lg text-[11px] font-extrabold bg-brand-coral/25 text-brand-coral border border-brand-coral/50"
                : clinicalCase.allergyType === 'warning'
                ? "px-2.5 py-1 rounded-lg text-[11px] font-extrabold bg-brand-amber/25 text-brand-amber border border-brand-amber/50"
                : "px-2.5 py-1 rounded-lg text-[11px] font-extrabold bg-brand-mint/20 text-brand-mint border border-brand-mint/40";

