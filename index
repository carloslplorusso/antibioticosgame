        function handleCaseCompletion(clinicalCase, completeNode) {
            if (!gameState.completedCases.includes(clinicalCase.id)) {
                gameState.completedCases.push(clinicalCase.id);
                gameState.score += 150;
                updateHUD();
            }
            playSound('fanfare');

            document.getElementById('completeModalTitle').textContent = clinicalCase.title;
            document.getElementById('completeModalSummary').textContent = completeNode.summary;
            document.getElementById('completeModalScore').textContent = `${gameState.score} pts`;
            document.getElementById('completeModalRescues').textContent = `${gameState.rescuesInCurrentCase}`;

            const nextId = clinicalCase.id < CLINICAL_CASES.length ? clinicalCase.id + 1 : 1;
            document.getElementById('nextCaseBtn').onclick = () => {
                document.getElementById('caseCompleteModal').classList.add('hidden');
                startCase(nextId);
            };

            document.getElementById('caseCompleteModal').classList.remove('hidden');
        }

