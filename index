            document.getElementById('simulatorScreen').classList.remove('hidden');

            renderCurrentNode();
        }

        function renderCurrentNode() {
            const clinicalCase = CLINICAL_CASES.find(c => c.id === gameState.currentCaseId);
            const node = clinicalCase.nodes[gameState.currentNodeKey];
            if (!node) return;

            if (node.type === 'complete') {
                handleCaseCompletion(clinicalCase, node);
                return;
            }

            // 1. Minimalist Step Breadcrumbs
            const bc = document.getElementById('algorithmBreadcrumb');
            bc.innerHTML = gameState.visitedPath.map((s, idx) => {
                const color = s.status === 'optimal' ? 'bg-brand-mint text-brand-night'
                            : s.status === 'valid' ? 'bg-brand-amber text-brand-night'
                            : s.status === 'wrong' ? 'bg-brand-coral text-white'
                            : 'bg-white/15 text-white';
                return `
                    <div class="flex items-center gap-1 shrink-0">
                        <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold ${color}">${idx + 1}. ${s.label}</span>
                        ${idx < gameState.visitedPath.length - 1 ? `<i class="ph-bold ph-caret-right text-white/30 text-xs"></i>` : ''}
                    </div>
                `;
            }).join('');

            // 2. Vitals & Stability
            document.getElementById('vitalTemp').textContent = node.vitals.temp;
            document.getElementById('vitalTrismus').textContent = node.vitals.trismus;
            document.getElementById('vitalAirway').textContent = node.vitals.airway;

            const bar = document.getElementById('stabilityBar');
            const stText = document.getElementById('stabilityText');
            bar.style.width = `${node.vitals.stability}%`;
            stText.textContent = `${node.vitals.stability}%`;

            const card = document.getElementById('scenarioNarrativeCard');
            const alertBanner = document.getElementById('complicationAlertBanner');

            if (node.type === 'complication') {
                bar.className = "h-full rounded-full bg-brand-coral transition-all duration-500";
                stText.className = "font-mono text-brand-coral";
                alertBanner.classList.remove('hidden');
                card.classList.add('border-brand-coral');
            } else {
                bar.className = "h-full rounded-full bg-brand-mint transition-all duration-500";
                stText.className = "font-mono text-brand-mint";
                alertBanner.classList.add('hidden');
                card.classList.remove('border-brand-coral');
            }

            // 3. Visual Avatar / Diagram
            renderPatientVisualizer(node.visualState);
            // 4. Text & Options (Shuffled dynamically so position is never predictable)
            document.getElementById('nodeStageLabel').textContent = node.stage;
            document.getElementById('nodeHeadline').textContent = node.headline;
            document.getElementById('nodeDescription').innerHTML = node.description;

            gameState.currentShuffledOptions = shuffleOptionsAvoidingA(node.options);

            const optionsContainer = document.getElementById('optionsContainer');
            optionsContainer.innerHTML = gameState.currentShuffledOptions.map((opt, idx) => `
                <button onclick="selectDecisionOption(${idx})" class="option-card w-full text-left rounded-2xl p-4 flex items-center justify-between gap-3 group">
                    <div class="flex items-start gap-3.5">
                        <div class="w-8 h-8 rounded-xl bg-white/10 group-hover:bg-brand-mint group-hover:text-brand-night font-display font-black text-xs flex items-center justify-center shrink-0 mt-0.5 transition">
                            ${String.fromCharCode(65 + idx)}
                        </div>
                        <div>
                            <div class="font-bold text-sm sm:text-base text-white group-hover:text-brand-mint transition leading-snug">
                                ${opt.title}
                            </div>
                            <div class="text-xs text-brand-lavender/75 mt-0.5">
                                ${opt.detail}
                            </div>
                        </div>
                    </div>
                    <i class="ph-bold ph-caret-right text-white/40 group-hover:text-brand-mint group-hover:translate-x-0.5 transition text-lg shrink-0"></i>
                </button>
            `).join('');
        }

        function selectDecisionOption(optionIndex) {
            const clinicalCase = CLINICAL_CASES.find(c => c.id === gameState.currentCaseId);
            const chosen = gameState.currentShuffledOptions[optionIndex];
            if (!chosen) return;

            let earnedPoints = chosen.points;
            if (chosen.quality === 'optimal') {
                earnedPoints = Math.round(chosen.points * (1 + (gameState.streak - 1) * 0.15));
                gameState.streak = Math.min(gameState.streak + 1, 5);
                playSound('success');
            } else if (chosen.quality === 'valid') {
                playSound('partial');
            } else {
                gameState.streak = 1;
                gameState.rescuesInCurrentCase += 1;
                playSound('error');
            }

            gameState.score = Math.max(0, gameState.score + earnedPoints);
            updateHUD();
            triggerFloatingScore(earnedPoints);

            // Show minimalist feedback banner
            const fb = document.getElementById('lastDecisionFeedback');
            const iconBox = document.getElementById('feedbackIconBox');
            const titleEl = document.getElementById('feedbackTitle');
            const badgeEl = document.getElementById('feedbackPointsBadge');
            const rationaleEl = document.getElementById('feedbackRationale');

            fb.classList.remove('hidden');
            if (chosen.quality === 'optimal') {
                fb.className = "rounded-2xl px-4 py-3 border bg-brand-mint/15 border-brand-mint/40";
                iconBox.className = "w-8 h-8 rounded-lg bg-brand-mint text-brand-night flex items-center justify-center shrink-0";
                iconBox.innerHTML = `<i class="ph-bold ph-check"></i>`;
                titleEl.className = "font-extrabold text-xs uppercase text-brand-mint";
                titleEl.textContent = "Decisión Correcta";
                badgeEl.className = "font-mono font-bold text-xs px-2 py-0.5 rounded bg-brand-mint text-brand-night";
                badgeEl.textContent = `+${earnedPoints} pts`;
            } else if (chosen.quality === 'valid') {
                fb.className = "rounded-2xl px-4 py-3 border bg-brand-amber/15 border-brand-amber/40";
                iconBox.className = "w-8 h-8 rounded-lg bg-brand-amber text-brand-night flex items-center justify-center shrink-0";
                iconBox.innerHTML = `<i class="ph-bold ph-info"></i>`;
                titleEl.className = "font-extrabold text-xs uppercase text-brand-amber";
                titleEl.textContent = "Opción Parcial";
                badgeEl.className = "font-mono font-bold text-xs px-2 py-0.5 rounded bg-brand-amber text-brand-night";
                badgeEl.textContent = `+${earnedPoints} pts`;
            } else {
                fb.className = "rounded-2xl px-4 py-3 border bg-brand-coral/20 border-brand-coral";
                iconBox.className = "w-8 h-8 rounded-lg bg-brand-coral text-white flex items-center justify-center shrink-0";
                iconBox.innerHTML = `<i class="ph-bold ph-x"></i>`;
                titleEl.className = "font-extrabold text-xs uppercase text-brand-coral";
                titleEl.textContent = "Decisión Incorrecta";
                badgeEl.className = "font-mono font-bold text-xs px-2 py-0.5 rounded bg-brand-coral text-white";
                badgeEl.textContent = `${earnedPoints} pts`;
            }
            rationaleEl.textContent = chosen.rationale;

            // Move to next step
            gameState.currentNodeKey = chosen.nextNode;
            const nextNodeObj = clinicalCase.nodes[chosen.nextNode];
            if (nextNodeObj && nextNodeObj.type !== 'complete') {
                const label = chosen.quality === 'optimal' ? 'Mejoría' : chosen.quality === 'valid' ? 'Alternativa' : 'Complicación';
                gameState.visitedPath.push({ label, status: chosen.quality });
            }

            renderCurrentNode();
        }

